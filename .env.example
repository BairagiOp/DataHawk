# DataHawk Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API (for LLM-based sentiment and topic labeling)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: OpenAI API (alternative to Gemini)
# OPENAI_API_KEY=your_openai_key_here

# Research Settings
RANDOM_SEED=42
LOG_LEVEL=INFO

# Trend Scoring Weights (for ablation studies)
ALPHA=0.2  # Volume weight
BETA=0.4   # Growth weight
GAMMA=0.3  # Engagement weight
DELTA=0.1  # Novelty weight

# Clustering Parameters
MIN_CLUSTER_SIZE=5
UMAP_DIMENSIONS=5

# Forecasting
FORECAST_HORIZON=7

# Data Collection (Ethical Guidelines)
# Set to true only if you have explicit permission
ENABLE_WEB_SCRAPING=false
RESPECT_ROBOTS_TXT=true
RATE_LIMIT_SECONDS=1.0
